# Server
PORT=3001
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/hazardlens

# JWT
JWT_SECRET=change-this-to-a-real-secret-in-production
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173
PYTHON_AI_URL=http://127.0.0.1:8000


# AWS S3 Location Database Download (Required for dataset downloading if data/locations.db is not present locally)
AWS_REGION=eu-north-1
S3_BUCKET=hazardlens
LOCATION_DB_S3_KEY=database/locations.db
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here

# npx kill-port 3001
